import collections.abc
import typing

import numpy

from dwave.optimization import Model, symbols
from dwave.optimization._mixins import ArrayInfo, _ArraySymbolMixin, _StatesMixin, _SymbolMixin

class _Graph:
    def __init__(self) -> typing.NoReturn: ...
    def add_constraint(self, value: ArraySymbol) -> ArraySymbol: ...
    def decision_state_size(self) -> int: ...
    def is_locked(self) -> bool: ...
    def iter_constraints(self) -> collections.abc.Iterator[ArraySymbol]: ...
    def iter_decisions(self) -> collections.abc.Iterator[Symbol]: ...
    def iter_inputs(self) -> collections.abc.Iterator[symbols.Input]: ...
    def iter_symbols(self) -> collections.abc.Iterator[Symbol]: ...
    def _ith_node(self, i: int) -> Symbol: ...
    def lock(self) -> None: ...
    def minimize(self, value: ArraySymbol) -> None: ...
    def num_constraints(self) -> int: ...
    def num_decisions(self) -> int: ...
    def num_inputs(self) -> int: ...
    def num_nodes(self) -> int: ...
    def num_symbols(self) -> int: ...
    @property
    def objective(self) -> ArraySymbol | None: ...
    @objective.setter
    def objective(self, value: ArraySymbol): ...
    def remove_redundant_symbols(self, time_limit_s: float | None = None) -> int: ...
    def remove_unused_symbols(self) -> int: ...
    def state_size(self) -> int: ...
    def unlock(self) -> None: ...

class Symbol(_SymbolMixin):
    def __init__(self) -> typing.NoReturn: ...
    def expired(self) -> bool: ...
    def has_state(self, index: int = 0) -> bool: ...
    def id(self) -> int: ...
    def iter_predecessors(self) -> collections.abc.Iterator[Symbol]: ...
    def iter_successors(self) -> collections.abc.Iterator[Symbol]: ...
    @property
    def model(self) -> Model: ...
    def reset_state(self, index: int) -> None: ...
    def shares_memory(self, other: Symbol) -> bool: ...
    def state_size(self) -> int: ...
    def topological_index(self) -> int: ...

class ArraySymbol(Symbol, _ArraySymbolMixin):
    def __init__(self) -> typing.NoReturn: ...
    def info(self) -> ArrayInfo: ...
    def ndim(self) -> int: ...
    def shape(self) -> tuple[int, ...]: ...
    def size(self) -> int | symbols.Size: ...
    def state(self, index: int = 0, *, copy: bool = True) -> numpy.ndarray: ...
    def state_size(self) -> int: ...
    def strides(self) -> tuple[int, ...]: ...

def _broadcast_shapes(
    lhs: collections.abc.Iterable[int],
    rhs: collections.abc.Iterable[int],
) -> tuple[int, ...]: ...

class States(_StatesMixin):
    def __init__(self, model: Model) -> None: ...
    def __len__(self) -> int: ...
    def clear(self) -> None: ...
    def initialize(self) -> None: ...
    def _reset_intermediate_states(self) -> None: ...
    def resize(self, n: int) -> None: ...
    def size(self) -> int: ...
